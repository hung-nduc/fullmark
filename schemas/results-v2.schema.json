{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fullmark-results-v2",
  "title": "fullmark results, version 2",
  "description": "fullmark-results, version 2: one attempt at a quiz, as the page saves it (TECHNICAL_DESIGN.md, section 4, results-v2).",
  "type": "object",
  "properties": {
    "quizHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "full",
            "bank",
            "section",
            "missed",
            "retry"
          ]
        },
        "section": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionOrder": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "seed": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "questions"
      ]
    },
    "state": {
      "type": "object",
      "properties": {
        "answers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "submittedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeUsed": {
          "type": "number",
          "minimum": 0
        },
        "sectionTime": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "flagged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timedOut": {
          "type": "boolean"
        }
      },
      "required": [
        "answers",
        "startedAt",
        "submittedAt",
        "timeUsed",
        "sectionTime",
        "flagged",
        "checked",
        "timedOut"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "start",
        "answering",
        "submitted"
      ]
    },
    "format": {
      "type": "string",
      "const": "fullmark-results"
    },
    "version": {
      "type": "number",
      "const": 2
    },
    "bundle": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string"
        },
        "sitting": {
          "type": "string"
        }
      },
      "required": [
        "hash",
        "sitting"
      ]
    }
  },
  "required": [
    "quizHash",
    "plan",
    "state",
    "phase",
    "format",
    "version"
  ]
}
